# ==========================================
# PLANTILLA DE VARIABLES DE ENTORNO MERQUENPOS
# ==========================================

# --- MODO DEL SERVIDOR ---
# True para entorno de pruebas/desarrollo. En Producción (hoteles) DEBE ser False.
DJANGO_DEBUG=True

# --- HOSTS Y RED ---
# IPs o dominios desde donde se puede acceder (separados por coma). 
# Ej. producción: 192.168.1.50,merquenpos.local
# Ej. desarrollo: *
DJANGO_ALLOWED_HOSTS=*

# --- SEGURIDAD CSRF (Orígenes de Confianza) ---
# Fundamental para permitir el Login desde tablets y PCs de la red.
# OBLIGATORIO incluir http:// o https:// al inicio. Separar por comas si hay varios.
# Ej. producción: http://192.168.1.50,http://merquenpos.local
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost

# --- CLAVE SECRETA ---
# En desarrollo puedes dejar un texto cualquiera.
# EN PRODUCCIÓN DEBES GENERAR UNA NUEVA POR CADA CLIENTE.
# Generar usando la terminal: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=escribe_aqui_una_clave_secreta_para_produccion

# --- CREDENCIALES DE BASE DE DATOS SQL SERVER ---
DB_NAME=MerquenDB
DB_USER=tu_usuario_sql
DB_PASSWORD=tu_contraseña_segura
DB_HOST=localhost\SQLEXPRESS